// ==============================================================================
// SMART HOME IoT — PRISMA SCHEMA (MYSQL HOSTINGER)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Device {
  id              Int       @id @default(autoincrement())
  deviceId        String    @unique @map("device_id") @db.VarChar(64)
  name            String    @db.VarChar(128)
  deviceType      String    @default("ESP32_DEV_KIT_V1") @map("device_type") @db.VarChar(64)
  lastIp          String?   @map("last_ip") @db.VarChar(64)
  firmwareVersion String?   @map("firmware_version") @db.VarChar(32)
  lastStatus      String    @default("OFFLINE") @map("last_status") @db.VarChar(32)
  capabilities    String?   @db.VarChar(255) // JSON string: ["dht22", "bh1750", "led"]
  lastSeenAt      DateTime? @map("last_seen_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sensorReadings SensorReading[]
  deviceState    DeviceState?
  controlLogs    ControlLog[]

  @@map("devices")
}

model SensorReading {
  id          BigInt   @id @default(autoincrement())
  deviceId    String   @map("device_id") @db.VarChar(64)
  temperature Float?   @db.Float
  humidity    Float?   @db.Float
  lightLux    Float?   @map("light_lux") @db.Float
  isSimulated Boolean  @default(false) @map("is_simulated")
  recordedAt  DateTime @default(now()) @map("recorded_at")

  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@index([deviceId, recordedAt], name: "idx_device_recorded")
  @@map("sensor_readings")
}

model DeviceState {
  id         Int       @id @default(autoincrement())
  deviceId   String    @unique @map("device_id") @db.VarChar(64)
  isOnline   Boolean   @default(false) @map("is_online")
  lampState  Boolean   @default(false) @map("lamp_state")
  lastPingAt DateTime? @map("last_ping_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@map("device_states")
}

model ControlLog {
  id             Int       @id @default(autoincrement())
  deviceId       String    @map("device_id") @db.VarChar(64)
  command        String    @db.VarChar(64)
  requestedState Boolean   @map("requested_state")
  confirmedState Boolean?  @map("confirmed_state")
  status         String    @default("PENDING") @db.VarChar(32) // PENDING, SUCCESS, FAILED
  errorMessage   String?   @map("error_message") @db.Text
  isSimulated    Boolean   @default(false) @map("is_simulated")
  executedAt     DateTime  @default(now()) @map("executed_at")
  confirmedAt    DateTime? @map("confirmed_at")

  device Device @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@index([deviceId, executedAt], name: "idx_control_executed")
  @@map("control_logs")
}

model SystemSetting {
  id           Int      @id @default(autoincrement())
  settingKey   String   @unique @map("setting_key") @db.VarChar(64)
  settingValue String   @map("setting_value") @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
